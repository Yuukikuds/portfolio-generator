# Copy this file to ".env" for local development. NEVER commit the real .env file.

APP_NAME=PortfolioCraft
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_LEVEL=debug

# Railway PostgreSQL. For LOCAL development paste the Railway PUBLIC connection URL.
# On Railway, set DB_URL to ${{Postgres.DATABASE_URL}} in the service variables.
DB_CONNECTION=pgsql
DB_URL=your_railway_postgresql_connection_string

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
